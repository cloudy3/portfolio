{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "next analyze",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:mobile": "node scripts/lighthouse.mjs mobile",
    "lighthouse:desktop": "node scripts/lighthouse.mjs desktop",
    "perf:audit": "npm run build && npm run lighthouse",
    "audit:deps": "knip",
    "audit:security": "npm audit",
    "audit:all": "npm run audit:security && npm run audit:deps"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "^16.4.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
