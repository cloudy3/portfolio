{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "next analyze",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:mobile": "node scripts/lighthouse.mjs mobile",
    "lighthouse:desktop": "node scripts/lighthouse.mjs desktop",
    "perf:audit": "npm run build && npm run lighthouse",
    "audit:deps": "knip",
    "audit:security": "npm audit",
    "audit:all": "npm run audit:security && npm run audit:deps"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "clsx": "^2.1.1",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
