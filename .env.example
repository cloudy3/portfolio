# Copy to .env.local and fill in. See DEPLOYMENT.md for what each one does.

# Contact form (https://dashboard.emailjs.com). The site runs without these;
# the form shows an error on send until all three are set.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional. Base for canonical, Open Graph, robots and sitemap URLs. Defaults to
# the production domain on Vercel and http://localhost:3000 elsewhere.
# NEXT_PUBLIC_SITE_URL=
